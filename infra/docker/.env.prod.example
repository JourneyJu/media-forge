APP_DOMAIN=example.com
PUBLIC_ORIGIN=https://example.com

POSTGRES_DB=mediaforge
POSTGRES_USER=mediaforge
POSTGRES_PASSWORD=change-this-postgres-password

MINIO_ROOT_USER=mediaforge
MINIO_ROOT_PASSWORD=change-this-minio-password-at-least-16-chars
S3_BUCKET=mediaforge-prod

AUTH_BOOTSTRAP_ADMIN_ACCOUNT=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-this-initial-admin-password
AUTH_JWT_PRIVATE_KEY_PEM=replace-with-rsa-private-key-pem-escaped-newlines
AUTH_PASSWORD_PRIVATE_KEY_PEM=replace-with-rsa-private-key-pem-escaped-newlines

MODEL_MODE=demo
CREATION_RUN_WORKER_CONCURRENCY=2
