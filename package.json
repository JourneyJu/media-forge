{
  "name": "mediaforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @mediaforge/auth --filter @mediaforge/service --filter @mediaforge/web dev",
    "dev:auth": "pnpm --filter @mediaforge/auth dev",
    "dev:service": "pnpm --filter @mediaforge/service dev",
    "dev:worker": "pnpm --filter @mediaforge/worker dev",
    "dev:web": "pnpm --filter @mediaforge/web dev",
    "db:migrate": "pnpm --filter @mediaforge/service db:migrate && pnpm --filter @mediaforge/auth db:migrate",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
