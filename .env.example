DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mediaforge
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=mediaforge-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

APP_ENV=local
MODEL_MODE=gateway

# 本地联调可显式改为 demo；生产环境必须使用 gateway。
# MODEL_MODE=demo

# Model Gateway（以下三项同时配置后启用真实模型，否则使用本地演示生成器）
MODEL_GATEWAY_PROVIDER=openai-compatible
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_DEFAULT_MODEL=
MODEL_GATEWAY_TIMEOUT_MS=60000

# Vision Gateway（火山方舟；模型填写支持视觉输入的推理接入点 ID）
VISION_GATEWAY_PROVIDER=volcengine-ark
VISION_GATEWAY_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_GATEWAY_API_KEY=
VISION_GATEWAY_MODEL=
VISION_GATEWAY_TIMEOUT_MS=60000

# Web
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SERVICE_URL=http://localhost:4000
