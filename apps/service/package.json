{
  "name": "@mediaforge/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./creation-worker": "./src/creation-graph/worker.ts",
    "./maintenance-worker": "./src/maintenance-worker.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "db:migrate": "tsx src/migrate.ts",
    "worker:dev": "tsx watch src/creation-graph/worker-main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/service/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@langchain/langgraph": "^1.4.8",
    "@mediaforge/contracts": "workspace:*",
    "bullmq": "^5.81.2",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
