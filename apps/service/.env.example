PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mediaforge
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=mediaforge-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MODEL_CONFIG_ENCRYPTION_KEY=

# Agent 分析动态旁路；生产默认保持关闭，先使用 shadow mode 验证。
REASONING_SUMMARIZER_ENABLED=false
REASONING_SUMMARIZER_SHADOW_MODE=true
REASONING_SUMMARIZER_MIN_CHARS=300
REASONING_SUMMARIZER_MIN_AGE_MS=3000
REASONING_SUMMARIZER_MIN_INTERVAL_MS=8000
REASONING_SUMMARIZER_SECOND_AFTER_MS=12000
REASONING_SUMMARIZER_MAX_PER_AGENT=2
REASONING_SUMMARIZER_MAX_PER_RUN=6
REASONING_SUMMARIZER_CONCURRENCY=2
REASONING_SUMMARIZER_TIMEOUT_MS=4000
